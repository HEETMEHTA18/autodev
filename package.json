{
  "name": "autodev",
  "private": true,
  "version": "0.4.1",
  "description": "Clone. Scan. Install. Build. — Open-source developer environment bootstrapper",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "website": "pnpm --filter=website dev",
    "cli:build": "cd packages/cli && go build -o bin/autodev ./main.go",
    "cli:test": "cd packages/cli && go test ./...",
    "cli:install": "cd packages/cli && go install ./...",
    "npm:test": "pnpm --filter=@heetmehta18/autodev test"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.9.16"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "main": "index.js",
  "dependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-module-utils": "^2.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1",
    "typescript-eslint": "^8.60.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
