{
  "name": "autodev",
  "version": "0.6.1",
  "private": true,
  "description": "Clone. Scan. Install. Build. — Open-source developer environment bootstrapper",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "website": "pnpm --filter=website dev",
    "cli:build": "cd packages/cli && go build -o bin/autodev ./main.go",
    "cli:test": "cd packages/cli && go test ./...",
    "cli:install": "cd packages/cli && go install ./...",
    "npm:test": "pnpm --filter=@heetmehta18/autodev test"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.9.16"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "main": "index.js",
  "dependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.3",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-scope": "^8.4.0",
    "typescript-eslint": "^8.60.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": ">=2.11.0 <3",
      "brace-expansion@1.1.18": "1.1.21",
      "brace-expansion@5.0.9": "5.0.12",
      "browserslist": ">=4.28.7 <5",
      "js-yaml": ">=5.4.1 <6",
      "nanoid": ">=3.3.14",
      "postcss": ">=8.5.16",
      "sharp": ">=0.35.5 <0.36",
      "source-map-js": ">=1.2.2 <2",
      "zod": ">=4.6.6 <5"
    }
  }
}
